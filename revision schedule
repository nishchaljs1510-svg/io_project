from flask import Flask, request, jsonify
from flask_cors import CORS  # <-- Import CORS
import math

# Initialize the Flask application
app = Flask(__name__)
CORS(app)  # <-- THIS IS THE FIX. Add this line.

@app.route('/suggest_study_plan', methods=['POST'])
def suggest_plan():
    """
    Suggests a revision schedule based on topics and available days.
    Expects a JSON payload like:
    {
        "topics": ["Math", "Physics", "Chemistry", "History", "Biology"],
        "days": 7
    }
    """
    try:
        # Get the JSON data from the incoming request
        data = request.get_json()

        # Validate that the required keys are present
        if not data or 'topics' not in data or 'days' not in data:
            return jsonify({"error": "Missing 'topics' or 'days' in request body"}), 400

        topics = data['topics']
        days = int(data['days'])

        if not isinstance(topics, list) or not topics:
            return jsonify({"error": "'topics' must be a non-empty list"}), 400
        
        if days <= 0:
            return jsonify({"error": "'days' must be a positive number"}), 400

        # --- Simple Scheduling Logic ---
        schedule = {}
        topic_count = len(topics)
        topics_per_day = math.ceil(topic_count / days)
        
        topic_index = 0
        for day in range(1, days + 1):
            day_key = f"Day {day}"
            day_topics = []
            
            for _ in range(topics_per_day):
                if topic_index < topic_count:
                    day_topics.append(topics[topic_index])
                    topic_index += 1
            
            if day_topics:
                schedule[day_key] = day_topics
            else:
                break

        return jsonify({
            "status": "success",
            "message": "Study plan generated.",
            "requested_topics": topics,
            "requested_days": days,
            "suggested_schedule": schedule
        }), 200

    except Exception as e:
        return jsonify({"error": "An unexpected error occurred", "details": str(e)}), 500

if __name__ == '__main__':
    # Run the app in debug mode for development
    app.run(debug=True, host='0.0.0.0', port=5001)
